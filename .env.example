# Ticket — configuration reference.
#
# These are NOT read from a .env file. hardhat.config.ts reads them through Hardhat's
# encrypted variable store, so they never sit in plaintext in the repo or in a shell history
# file. This file exists to name them.
#
#   npx hardhat vars set MNEMONIC
#   npx hardhat vars set SEPOLIA_RPC_URL
#   npx hardhat vars set ETHERSCAN_API_KEY
#
# Unset, MNEMONIC falls back to the well-known Hardhat test mnemonic and SEPOLIA_RPC_URL to a
# public endpoint, so `npx hardhat test` works on a clean checkout with nothing configured.

# 12 words. Account 0 is the deployer, account 1 is the keeper that drives draw steps.
MNEMONIC=

# Any Sepolia JSON-RPC endpoint.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Only needed for `npm run verify:sepolia`.
ETHERSCAN_API_KEY=
